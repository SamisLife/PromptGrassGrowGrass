# Copy to `.env` in this folder. `.env` is gitignored.
#
# Board USB serial numbers never change (port names do). Find yours with:
#   npm run scan
# or: arduino-cli board list --format json  (look for "serialNumber")
#
# All three are optional. With none set, the backend asks each connected board
# once what it is (opens the console briefly, then releases it) and prints the
# lines to paste here. It will not send `p` while identifying.

# The board running firmware/pour (the water bottle servo)
POUR_BOARD_SERIAL=

# The boards running firmware/sensor_test (moisture + temperature), one per zone
SENSOR_A_BOARD_SERIAL=
SENSOR_B_BOARD_SERIAL=


# HTTP bind. Default is laptop-only. Binding beyond loopback requires AUTH_TOKEN
# for pour endpoints (see README).
# HOST=127.0.0.1
# PORT=8787

# Required for pour_water / POST /api/pour (and legacy POST /pour) when HOST is
# not a loopback address. Also accepted on loopback if set.
# AUTH_TOKEN=

# Server-side pour guards (firmware limits still apply on top of these).
# Max accepted pours in a rolling window. Default 8 / 10 minutes: enough for a
# demo (typically 2–4 pours) without emptying the half-bottle or flooding the
# container. The firmware already enforces one-at-a-time + 4 s cooldown.
# POUR_MAX_PER_WINDOW=8
# POUR_WINDOW_MS=600000
#
# Refuse a pour when zone A's relative moisture is at or above this percent
# (the app's "wet" band), unless the caller passes force=true.
# POUR_WET_PCT=78

# Override the pour board port for a one-off (skips serial matching).
# BOARD_PORT=/dev/cu.usbmodemXXXX

# Leave consoles closed. Every probe stays offline (null). Nothing is simulated.
# Use this when a backend is already running on the boards, or you have no hardware.
# HARDWARE=off

# xAI API key for the optional Grok voice assistant. Never sent to the browser.
# Create a key at https://console.x.ai/ — needs Speech-to-Speech / Voice Agent access.
# With this unset, the backend is unchanged and GET /api/voice/status reports disabled.
# XAI_API_KEY=
