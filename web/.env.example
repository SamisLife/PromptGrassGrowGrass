# Copy this file to `.env` (same folder) and fill in your own boards. `.env` is gitignored.
# The backend reads this file too (after backend/.env), so the serials can live in either place.
#
# Boards are told apart by their USB serial number: it never changes, whichever USB socket
# a board is plugged into. To find yours, plug the boards in and run, from backend/:
#     npm run scan
# (or: arduino-cli board list --format json, look for "serialNumber")
#
# All three are optional. Without them the backend asks each connected board once what it is.

# The board running firmware/pour (the water bottle servo)
POUR_BOARD_SERIAL=

# The boards running firmware/sensor_test (moisture + temperature), one per zone
SENSOR_A_BOARD_SERIAL=
SENSOR_B_BOARD_SERIAL=

# Optional. Where the web app finds the backend (default http://127.0.0.1:8787).
# Only variables starting with VITE_ are ever visible to the browser; the serials above are not.
# VITE_BACKEND=http://127.0.0.1:8787
